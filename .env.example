# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kanbandb
DB_USERNAME=kanban
DB_PASSWORD=your_secure_password_here
DB_USE_SSL=false

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-256-bit-secret-change-this-in-production-environment-must-be-very-long-and-random

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Frontend API & CORS Configuration
VITE_API_URL=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Admin User Bootstrapping
ADMIN_ENABLED=true
ADMIN_EMAIL=admin@taskhub.com
ADMIN_PASSWORD=admin

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kanbandb
DB_USERNAME=kanban
DB_PASSWORD=your_secure_password_here
DB_USE_SSL=false

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-256-bit-secret-change-this-in-production-environment-must-be-very-long-and-random

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare Pages origin after deploy, e.g. https://dinacharya.<subdomain>.workers.dev
# FRONTEND_URL=https://dinacharya.your-account.workers.dev

# Keep-alive self-ping (set this to your deployed URL to prevent container sleeping)
# APP_PUBLIC_URL=https://your-app.onrender.com

# Admin User Bootstrapping
ADMIN_ENABLED=true
ADMIN_EMAIL=admin@taskhub.com
ADMIN_PASSWORD=admin

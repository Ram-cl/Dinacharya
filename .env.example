# ===================================================
# KANBAN / DINACHARYA DASHBOARD - ENVIRONMENT CONFIG
# ===================================================
# Copy this file to '.env' and populate with your values:
# cp .env.example .env
# ===================================================

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kanbandb
DB_USER=kanban
DB_USERNAME=kanban
DB_PASSWORD=DinacharyaSecureDBPass123!
DB_USE_SSL=false

# JWT Security Configuration (MUST be a 256-bit / 32+ char secret in production)
JWT_SECRET=dinacharya_super_secret_jwt_key_256_bits_minimum_32_characters_long_key_2026
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Spring Profile & Application Server
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Frontend API & CORS Security
VITE_API_URL=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://*.workers.dev,https://*.pages.dev

# Admin User Bootstrapping (Initial credentials on first boot)
ADMIN_ENABLED=true
ADMIN_EMAIL=admin@taskhub.com
ADMIN_PASSWORD=Admin@123456

# Optional Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Email SMTP Configuration
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@dinacharya.local

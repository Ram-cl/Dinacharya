# ===================================================
# KANBAN DASHBOARD - PRODUCTION ENVIRONMENT
# ===================================================
# IMPORTANT: Update all values before deployment
# DO NOT commit this file to version control
# ===================================================

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kanbandb
DB_USER=kanban
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_MIN_16_CHARS

# JWT Configuration (CRITICAL - Change in production!)
JWT_SECRET=CHANGE_ME_GENERATE_256_BIT_RANDOM_STRING_MINIMUM_32_CHARACTERS
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Application Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Frontend Configuration
VITE_API_URL=https://yourdomain.com/api/v1

# Admin User Configuration (Change these!)
ADMIN_ENABLED=true
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_SECURE_ADMIN_PASSWORD

# Cloudinary Configuration (Optional - for file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (Optional - for notifications)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# SSL Configuration
SSL_ENABLED=false
SSL_KEY_STORE=/path/to/keystore.jks
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=JKS

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/kanban/app.log

# Performance Configuration
DB_POOL_SIZE=20
CACHE_ENABLED=true
CACHE_TTL=3600

# Security Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Deployment Configuration
DEPLOYMENT_ENV=production
VERSION=1.0.0
